# Admin Dashboard Environment Variables

# Backend API URL (your Railway server URL) — used by client-side components
NEXT_PUBLIC_API_URL=https://api.getbrainlift.app/api

# Backend API URL (no /api suffix) — used by server-side API routes (search, upgrade)
API_BASE_URL=https://api.getbrainlift.app

# For local development
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
# API_BASE_URL=http://localhost:3001