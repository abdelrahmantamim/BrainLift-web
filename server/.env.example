# Server Configuration
NODE_ENV=development
PORT=5001

# Database (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your-better-auth-secret-key
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8081,http://localhost:19006

# Legacy JWT (for admin panel only)
JWT_SECRET=your-jwt-secret-key

# Social Sign-In (REQUIRED for Apple/Google OAuth — tokens are verified server-side)
# Apple: the app's bundle/service ID, used as the verification audience.
APPLE_CLIENT_ID=com.brainlift.app
# Google: any of these client IDs is accepted as the verification audience.
# Provision in Google Cloud Console (web/iOS/Android). Until set, Google Sign-In
# returns 500 (not configured) rather than trusting unverified tokens.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# Web origin allowlist (for web paid-tier session tagging)
WEB_ORIGINS=https://getbrainlift.app,http://localhost:5173,http://localhost:3000

# OpenAI API
OPENAI_API_KEY=your-openai-api-key

# Google AI (Optional)
GOOGLE_API_KEY=your-google-api-key

# Redis Configuration (Optional - will use in-memory cache if not provided)
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://default:your-redis-password@your-redis-host:6379

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Mobile URL (for CORS)
MOBILE_URL=http://localhost:8081

# App URL (for share links)
APP_URL=https://getbrainlift.app

# Canonical share link URLs (WP3). Used to build POST /share/create's
# shareUrl/previewUrl/qrCodeUrl response fields consumed by web + mobile.
# WEB_APP_URL: public web app origin, used for shareUrl/previewUrl.
# Defaults to https://getbrainlift.app when unset.
WEB_APP_URL=https://getbrainlift.app
# API_PUBLIC_URL: public API origin, used for the branded QR code URL.
# Defaults to https://app.getbrainlift.app when unset.
API_PUBLIC_URL=https://app.getbrainlift.app

# PostHog Analytics (Optional)
POSTHOG_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://us.i.posthog.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Logging
LOG_LEVEL=info

# Shutdown
SHUTDOWN_TIMEOUT=30000

# RevenueCat Webhook
# REQUIRED — the webhook refuses to process (500) without it; must match the
# Authorization header configured in the RevenueCat dashboard.
REVENUECAT_WEBHOOK_AUTH_KEY=your_revenuecat_webhook_auth_key

# PPTX Extraction Service
PPTX_SERVICE_URL=http://localhost:8001
# PPTX_API_KEY=your-pptx-service-api-key
